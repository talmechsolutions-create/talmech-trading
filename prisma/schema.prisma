model LogisticsProvider {
  id                           String   @id
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  status                       String   @default("PENDING_CONTRACT")
  companyName                  String
  contactName                  String?
  phone                        String?
  email                        String?
  website                      String?
  gstNumber                    String?
  panNumber                    String?
  address                      String?
  country                      String   @default("India")
  state                        String?
  city                         String?
  nearbyCities                 Json?
  serviceableCountries         Json?
  serviceableStates            Json?
  serviceableCities            Json?
  serviceTypes                 Json?
  specializations              Json?
  deliveryType                 String?
  speed                        String?
  capacityMt                   Float    @default(0)
  fleetSize                    Int      @default(0)
  availabilityDates            Json?
