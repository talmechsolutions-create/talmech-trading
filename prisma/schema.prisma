  ownerUserId String?
  accountId   String?
  firmName    String?
  contactName String?
  email       String?
  mobile      String?
  category    String?
  priority    String?
  subject     String?
  status      String   @default("Open")
  raw         Json?

  @@index([ownerUserId])
  @@index([accountId])
  @@index([status])
  @@index([email])
}

model WhatsappUpload {
